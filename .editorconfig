# https://editorconfig.org — conventions communes aux dépôts Kanibal Studio.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Deux espaces en fin de ligne sont un retour à la ligne Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
